{
  "name": "@tou/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "selftest": "tsx src/scripts/selftest.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
